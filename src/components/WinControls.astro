---
// src/components/WinControls.astro
import { Trophy } from "lucide-astro";
---

<footer
  class="bg-white dark:bg-slate-900 rounded-3xl p-4 sm:p-5 shadow-md border-2 border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 w-full transition-colors"
>
  <div class="text-center sm:text-left">
    <p
      class="text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500"
    >
      Fin de la ronda
    </p>
    <h3
      class="text-xs sm:text-base font-black text-slate-800 dark:text-slate-200"
    >
      ¿Quién adivinó el personaje?
    </h3>
  </div>

  <div class="grid grid-cols-2 gap-2 w-full sm:w-auto">
    <!-- Punto Naty -->
    <button
      type="button"
      id="btn-win-player-1"
      class="py-2.5 px-3 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-black text-xs sm:text-sm border-b-4 border-indigo-800 active:border-b-0 active:translate-y-1 shadow-md shadow-indigo-500/20 transition-all flex items-center justify-center gap-1.5 cursor-pointer truncate"
    >
      <Trophy class="w-3.5 h-3.5 text-white shrink-0" />
      <span class="truncate">Punto <span id="label-name-p1">Naty</span></span>
    </button>

    <!-- Punto cesar -->
    <button
      type="button"
      id="btn-win-player-2"
      class="py-2.5 px-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-white font-black text-xs sm:text-sm border-b-4 border-amber-700 active:border-b-0 active:translate-y-1 shadow-md shadow-amber-500/20 transition-all flex items-center justify-center gap-1.5 cursor-pointer truncate"
    >
      <Trophy class="w-3.5 h-3.5 text-white shrink-0" />
      <span class="truncate">Punto <span id="label-name-p2">Cesar</span></span>
    </button>
  </div>
</footer>

<script>
  import { launchConfetti } from "../utils/confetti";
  import { sounds } from "../utils/audio";

  const btnWinP1 = document.getElementById("btn-win-player-1")!;
  const btnWinP2 = document.getElementById("btn-win-player-2")!;
  const labelP1 = document.getElementById("label-name-p1")!;
  const labelP2 = document.getElementById("label-name-p2")!;

  window.addEventListener("game:players-updated", ((e: CustomEvent) => {
    if (e.detail?.p1Name) labelP1.textContent = e.detail.p1Name;
    if (e.detail?.p2Name) labelP2.textContent = e.detail.p2Name;
  }) as EventListener);

  function awardPoint(player: 1 | 2) {
    sounds.playVictory();
    launchConfetti();
    window.dispatchEvent(
      new CustomEvent("game:add-point", { detail: { player } }),
    );
  }

  btnWinP1.addEventListener("click", () => awardPoint(1));
  btnWinP2.addEventListener("click", () => awardPoint(2));
</script>
