---
// src/components/ScoreBoard.astro
import { Sparkles, Plus, Minus, RotateCcw, Sun, Moon, Users, Crown } from "lucide-astro";
---

<header
  class="bg-white dark:bg-slate-900 rounded-3xl p-4 sm:p-5 shadow-md border-2 border-slate-200/80 dark:border-slate-800 flex flex-col gap-3.5 w-full transition-colors"
>
  <!-- Fila Superior: Título + Botón Jugadores + Theme Toggle -->
  <div class="flex items-center justify-between w-full">
    <div class="flex items-center gap-2.5">
      <div
        class="w-10 h-10 rounded-2xl bg-indigo-600 text-white flex items-center justify-center shadow-md shadow-indigo-500/20 shrink-0 border-b-2 border-indigo-800"
      >
        <Sparkles class="w-5 h-5 text-white" />
      </div>
      <div>
        <h1
          class="text-base sm:text-xl font-black tracking-tight text-slate-900 dark:text-white leading-tight"
        >
          Adivina Quién
        </h1>
        <p
          class="text-[11px] sm:text-xs font-medium text-slate-500 dark:text-slate-400"
        >
          Disney & Pixar · Familia
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <!-- Botón Cambiar Jugadores -->
      <button
        type="button"
        id="btn-open-players-modal"
        class="h-10 px-3 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 font-bold text-xs flex items-center gap-1.5 border-2 border-indigo-200 dark:border-indigo-800 border-b-4 active:border-b-2 active:translate-y-0.5 transition cursor-pointer shadow-xs"
        title="Cambiar nombres o jugadores"
      >
        <Users class="w-4 h-4 text-indigo-600 dark:text-indigo-400" />
        <span class="hidden sm:inline">Jugadores</span>
      </button>

      <!-- Toggle Claro / Oscuro -->
      <button
        type="button"
        id="btn-theme-toggle"
        class="w-10 h-10 rounded-2xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-amber-400 flex items-center justify-center border-2 border-slate-200 dark:border-slate-700 border-b-4 active:border-b-2 active:translate-y-0.5 transition shadow-xs cursor-pointer shrink-0"
        title="Alternar Modo Claro / Oscuro"
      >
        <Sun class="w-4 h-4 hidden dark:block" />
        <Moon class="w-4 h-4 block dark:hidden" />
      </button>
    </div>
  </div>

  <!-- Fila Modo: Modo Normal (Infinito) vs Campeón de Campeones (Copa 5 o 10 pts) -->
  <div class="flex items-center justify-between px-1 text-[11px] font-bold text-slate-500 dark:text-slate-400 flex-wrap gap-1.5">
    <div class="flex items-center gap-1.5 text-slate-700 dark:text-slate-300 font-black">
      <Crown class="w-3.5 h-3.5 fill-amber-400 text-amber-500" />
      <span>Modo:</span>
    </div>
    <div class="flex items-center gap-1">
      <button
        type="button"
        id="btn-mode-free"
        class="px-2.5 py-0.5 rounded-lg text-[10px] font-black border transition cursor-pointer"
        title="Modo Normal: Puntos infinitos libres"
      >
        ♾️ Infinito
      </button>
      <button
        type="button"
        id="btn-target-5"
        class="px-2.5 py-0.5 rounded-lg text-[10px] font-black border transition cursor-pointer"
        title="Modo Campeón de Campeones: Copa a 5 puntos"
      >
        🏆 Copa a 5
      </button>
      <button
        type="button"
        id="btn-target-10"
        class="px-2.5 py-0.5 rounded-lg text-[10px] font-black border transition cursor-pointer"
        title="Modo Campeón de Campeones: Copa a 10 puntos"
      >
        🏆 Copa a 10
      </button>
    </div>
  </div>

  <!-- Fila Inferior: Marcador en 2 Columnas -->
  <div
    class="grid grid-cols-[1fr_auto_1fr_auto] items-center gap-1.5 sm:gap-2 bg-slate-100 dark:bg-slate-950 p-1.5 sm:p-2 rounded-2xl border-2 border-slate-200 dark:border-slate-800 w-full"
  >
    <!-- Jugador 1 -->
    <div
      class="relative flex items-center justify-between bg-white dark:bg-slate-900 px-2 sm:px-3 py-1.5 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 min-w-0"
    >
      <span
        id="crown-p1"
        class="hidden absolute -top-2.5 left-2 text-xs select-none pointer-events-none drop-shadow-xs"
        title="¡Líder de la partida!"
      >👑</span>

      <div class="flex items-center min-w-0 flex-1 mr-1">
        <span
          id="display-name-p1"
          class="text-xs sm:text-sm font-black text-indigo-700 dark:text-indigo-400 truncate"
        >
          Naty
        </span>
      </div>
      <div class="flex items-center gap-0.5 sm:gap-1 shrink-0">
        <button
          type="button"
          id="btn-minus-p1"
          class="w-5.5 h-5.5 sm:w-6 sm:h-6 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center border border-slate-200 dark:border-slate-700 active:translate-y-0.5 transition cursor-pointer"
          title="Restar 1 punto"
        >
          <Minus class="w-2.5 h-2.5 sm:w-3 sm:h-3 stroke-[3]" />
        </button>
        <span
          id="score-p1"
          class="text-sm sm:text-base font-black text-slate-900 dark:text-white bg-indigo-50 dark:bg-indigo-950/70 px-1.5 py-0.5 rounded-lg border border-indigo-200 dark:border-indigo-900 leading-none min-w-[20px] text-center"
        >
          0
        </span>
        <button
          type="button"
          id="btn-plus-p1"
          class="w-5.5 h-5.5 sm:w-6 sm:h-6 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs flex items-center justify-center border-b-2 border-indigo-800 active:border-b-0 active:translate-y-0.5 transition-all cursor-pointer shadow-xs shrink-0"
          title="Sumar 1 punto"
        >
          <Plus class="w-3 h-3 sm:w-3.5 sm:h-3.5 stroke-[3]" />
        </button>
      </div>
    </div>

    <span
      class="text-[9px] sm:text-[10px] font-black uppercase text-slate-400 dark:text-slate-500 px-0.5 select-none text-center"
      >VS</span
    >

    <!-- Jugador 2 -->
    <div
      class="relative flex items-center justify-between bg-white dark:bg-slate-900 px-2 sm:px-3 py-1.5 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 min-w-0"
    >
      <span
        id="crown-p2"
        class="hidden absolute -top-2.5 left-2 text-xs select-none pointer-events-none drop-shadow-xs"
        title="¡Líder de la partida!"
      >👑</span>

      <div class="flex items-center min-w-0 flex-1 mr-1">
        <span
          id="display-name-p2"
          class="text-xs sm:text-sm font-black text-amber-700 dark:text-amber-400 truncate"
        >
          César
        </span>
      </div>
      <div class="flex items-center gap-0.5 sm:gap-1 shrink-0">
        <button
          type="button"
          id="btn-minus-p2"
          class="w-5.5 h-5.5 sm:w-6 sm:h-6 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center border border-slate-200 dark:border-slate-700 active:translate-y-0.5 transition cursor-pointer"
          title="Restar 1 punto"
        >
          <Minus class="w-2.5 h-2.5 sm:w-3 sm:h-3 stroke-[3]" />
        </button>
        <span
          id="score-p2"
          class="text-sm sm:text-base font-black text-slate-900 dark:text-white bg-amber-50 dark:bg-amber-950/70 px-1.5 py-0.5 rounded-lg border border-amber-200 dark:border-amber-900 leading-none min-w-[20px] text-center"
        >
          0
        </span>
        <button
          type="button"
          id="btn-plus-p2"
          class="w-5.5 h-5.5 sm:w-6 sm:h-6 rounded-lg bg-amber-500 hover:bg-amber-400 text-white font-bold text-xs flex items-center justify-center border-b-2 border-amber-700 active:border-b-0 active:translate-y-0.5 transition-all cursor-pointer shadow-xs shrink-0"
          title="Sumar 1 punto"
        >
          <Plus class="w-3 h-3 sm:w-3.5 sm:h-3.5 stroke-[3]" />
        </button>
      </div>
    </div>

    <!-- Reset Marcador -->
    <button
      type="button"
      id="btn-reset-scores"
      class="w-7 h-7 rounded-lg bg-white dark:bg-slate-900 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 flex items-center justify-center border-b-2 border-slate-200 dark:border-slate-800 active:border-b-0 active:translate-y-0.5 transition cursor-pointer shrink-0 ml-0.5"
      title="Reiniciar marcador a cero"
    >
      <RotateCcw class="w-3.5 h-3.5" />
    </button>
  </div>

  <!-- MODAL / DIALOG PARA CONFIGURAR JUGADORES -->
  <dialog
    id="dialog-players"
    class="p-5 sm:p-6 rounded-3xl backdrop:bg-slate-950/75 backdrop:backdrop-blur-xs max-w-sm w-full border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl m-auto text-left transition-colors"
  >
    <div class="flex justify-between items-center mb-4">
      <h3
        class="text-sm font-black uppercase text-indigo-600 dark:text-indigo-400 tracking-wider flex items-center gap-2"
      >
        <Users class="w-4 h-4" /> Configurar Duelo
      </h3>
      <button
        type="button"
        id="btn-close-players"
        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg cursor-pointer"
      >
        ✕
      </button>
    </div>

    <!-- Presets Rápidos -->
    <div class="mb-4">
      <label
        class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mb-1.5"
      >
        Duelos Rápidos:
      </label>
      <div class="grid grid-cols-2 gap-2">
        <button
          type="button"
          id="preset-naty-cesar"
          class="py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-black text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition cursor-pointer text-center"
        >
          Naty vs César
        </button>
        <button
          type="button"
          id="preset-claudia-rodri"
          class="py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-black text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition cursor-pointer text-center"
        >
          Claudia vs Rodri
        </button>
      </div>
    </div>

    <!-- Formulario de Nombres -->
    <div class="flex flex-col gap-3">
      <div>
        <label
          for="input-edit-p1"
          class="text-xs font-bold text-slate-600 dark:text-slate-400 block mb-1"
        >
          Jugador 1:
        </label>
        <input
          type="text"
          id="input-edit-p1"
          class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 focus:border-indigo-600 focus:outline-hidden text-sm font-bold text-slate-900 dark:text-white"
        />
      </div>

      <div>
        <label
          for="input-edit-p2"
          class="text-xs font-bold text-slate-600 dark:text-slate-400 block mb-1"
        >
          Jugador 2:
        </label>
        <input
          type="text"
          id="input-edit-p2"
          class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 focus:border-amber-600 focus:outline-hidden text-sm font-bold text-slate-900 dark:text-white"
        />
      </div>

      <div class="flex items-center gap-2 mt-1">
        <input
          type="checkbox"
          id="check-reset-points"
          class="rounded text-indigo-600 focus:ring-0 cursor-pointer"
        />
        <label
          for="check-reset-points"
          class="text-xs font-medium text-slate-500 dark:text-slate-400 cursor-pointer select-none"
        >
          Reiniciar marcador a 0 - 0 al guardar
        </label>
      </div>

      <button
        type="button"
        id="btn-save-players"
        class="mt-2 w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-black text-xs uppercase tracking-wider border-b-4 border-indigo-800 active:border-b-0 active:translate-y-1 transition cursor-pointer shadow-sm"
      >
        Guardar Jugadores
      </button>
    </div>
  </dialog>
</header>

<script>
  import { sounds } from "../utils/audio";

  const STORAGE_KEY = "juegos_naty_adivina_quien_scores";

  type GameMode = "free" | "champion_5" | "champion_10";

  interface ScoreState {
    p1Name: string;
    p2Name: string;
    p1Score: number;
    p2Score: number;
    mode: GameMode;
  }

  function getStoredState(): ScoreState {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      if (data) {
        const parsed = JSON.parse(data);
        return {
          p1Name: parsed.p1Name || "Naty",
          p2Name: parsed.p2Name || "César",
          p1Score: Number(parsed.p1Score) || 0,
          p2Score: Number(parsed.p2Score) || 0,
          mode: parsed.mode || "free",
        };
      }
    } catch {}
    return { p1Name: "Naty", p2Name: "César", p1Score: 0, p2Score: 0, mode: "free" };
  }

  let state = getStoredState();
  let hasCrownedInThisMatch = false;

  const displayNameP1 = document.getElementById("display-name-p1")!;
  const displayNameP2 = document.getElementById("display-name-p2")!;
  const scoreP1 = document.getElementById("score-p1")!;
  const scoreP2 = document.getElementById("score-p2")!;
  const crownP1 = document.getElementById("crown-p1")!;
  const crownP2 = document.getElementById("crown-p2")!;
  const btnPlusP1 = document.getElementById("btn-plus-p1")!;
  const btnMinusP1 = document.getElementById("btn-minus-p1")!;
  const btnPlusP2 = document.getElementById("btn-plus-p2")!;
  const btnMinusP2 = document.getElementById("btn-minus-p2")!;
  const btnReset = document.getElementById("btn-reset-scores")!;
  const btnTheme = document.getElementById("btn-theme-toggle")!;

  // Botones de Modo
  const btnModeFree = document.getElementById("btn-mode-free")!;
  const btnTarget5 = document.getElementById("btn-target-5")!;
  const btnTarget10 = document.getElementById("btn-target-10")!;

  // Modal Jugadores
  const dialogPlayers = document.getElementById(
    "dialog-players",
  ) as HTMLDialogElement;
  const btnOpenPlayers = document.getElementById("btn-open-players-modal")!;
  const btnClosePlayers = document.getElementById("btn-close-players")!;
  const inputEditP1 = document.getElementById(
    "input-edit-p1",
  ) as HTMLInputElement;
  const inputEditP2 = document.getElementById(
    "input-edit-p2",
  ) as HTMLInputElement;
  const checkResetPoints = document.getElementById(
    "check-reset-points",
  ) as HTMLInputElement;
  const btnSavePlayers = document.getElementById("btn-save-players")!;
  const presetNatyCesar = document.getElementById("preset-naty-cesar")!;
  const presetClaudiaRodri = document.getElementById("preset-claudia-rodri")!;

  function syncUI() {
    displayNameP1.textContent = state.p1Name;
    displayNameP2.textContent = state.p2Name;
    scoreP1.textContent = state.p1Score.toString();
    scoreP2.textContent = state.p2Score.toString();

    // Actualizar botones de modo
    const inactiveBtnClass =
      "px-2.5 py-0.5 rounded-lg text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-200 dark:border-slate-700 cursor-pointer";

    btnModeFree.className = inactiveBtnClass;
    btnTarget5.className = inactiveBtnClass;
    btnTarget10.className = inactiveBtnClass;

    if (state.mode === "free") {
      btnModeFree.className =
        "px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-indigo-600 text-white border-indigo-700 shadow-xs cursor-pointer";
    } else if (state.mode === "champion_5") {
      btnTarget5.className =
        "px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-amber-500 text-white border-amber-600 shadow-xs cursor-pointer";
    } else if (state.mode === "champion_10") {
      btnTarget10.className =
        "px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-amber-500 text-white border-amber-600 shadow-xs cursor-pointer";
    }

    // Coronas dinámicas para quien va ganando
    if (state.p1Score > state.p2Score && state.p1Score > 0) {
      crownP1.classList.remove("hidden");
      crownP2.classList.add("hidden");
    } else if (state.p2Score > state.p1Score && state.p2Score > 0) {
      crownP2.classList.remove("hidden");
      crownP1.classList.add("hidden");
    } else {
      crownP1.classList.add("hidden");
      crownP2.classList.add("hidden");
    }

    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    window.dispatchEvent(
      new CustomEvent("game:players-updated", { detail: state }),
    );

    // Solo comprobar campeón si estamos en modo copa (5 o 10 puntos)
    checkChampion();
  }

  function checkChampion() {
    if (hasCrownedInThisMatch) return;
    if (state.mode === "free") return; // En modo libre, puntos infinitos

    const target = state.mode === "champion_5" ? 5 : 10;

    if (state.p1Score >= target || state.p2Score >= target) {
      hasCrownedInThisMatch = true;
      const isP1Winner = state.p1Score >= target;
      window.dispatchEvent(
        new CustomEvent("game:champion-crowned", {
          detail: {
            winnerName: isP1Winner ? state.p1Name : state.p2Name,
            winnerPlayer: isP1Winner ? 1 : 2,
            p1Score: state.p1Score,
            p2Score: state.p2Score,
            p1Name: state.p1Name,
            p2Name: state.p2Name,
            target,
          },
        }),
      );
    }
  }

  btnModeFree.addEventListener("click", () => {
    state.mode = "free";
    sounds.playQuestionTick();
    hasCrownedInThisMatch = false;
    syncUI();
  });

  btnTarget5.addEventListener("click", () => {
    state.mode = "champion_5";
    sounds.playQuestionTick();
    hasCrownedInThisMatch = false;
    syncUI();
  });

  btnTarget10.addEventListener("click", () => {
    state.mode = "champion_10";
    sounds.playQuestionTick();
    hasCrownedInThisMatch = false;
    syncUI();
  });

  btnPlusP1.addEventListener("click", () => {
    state.p1Score += 1;
    sounds.playVictory();
    syncUI();
  });

  btnMinusP1.addEventListener("click", () => {
    state.p1Score = Math.max(0, state.p1Score - 1);
    sounds.playQuestionTick();
    syncUI();
  });

  btnPlusP2.addEventListener("click", () => {
    state.p2Score += 1;
    sounds.playVictory();
    syncUI();
  });

  btnMinusP2.addEventListener("click", () => {
    state.p2Score = Math.max(0, state.p2Score - 1);
    sounds.playQuestionTick();
    syncUI();
  });

  btnReset.addEventListener("click", () => {
    state.p1Score = 0;
    state.p2Score = 0;
    hasCrownedInThisMatch = false;
    syncUI();
  });

  // Modal handlers
  btnOpenPlayers.addEventListener("click", () => {
    inputEditP1.value = state.p1Name;
    inputEditP2.value = state.p2Name;
    checkResetPoints.checked = false;
    dialogPlayers.showModal();
  });

  btnClosePlayers.addEventListener("click", () => dialogPlayers.close());
  dialogPlayers.addEventListener("click", (e) => {
    if (e.target === dialogPlayers) dialogPlayers.close();
  });

  presetNatyCesar.addEventListener("click", () => {
    inputEditP1.value = "Naty";
    inputEditP2.value = "César";
    sounds.playQuestionTick();
  });

  presetClaudiaRodri.addEventListener("click", () => {
    inputEditP1.value = "Claudia";
    inputEditP2.value = "Rodri";
    sounds.playQuestionTick();
  });

  btnSavePlayers.addEventListener("click", () => {
    state.p1Name = inputEditP1.value.trim() || "Jugador 1";
    state.p2Name = inputEditP2.value.trim() || "Jugador 2";
    if (checkResetPoints.checked) {
      state.p1Score = 0;
      state.p2Score = 0;
      hasCrownedInThisMatch = false;
    }
    syncUI();
    dialogPlayers.close();
    sounds.playVictory();
  });

  // Dark Mode Toggle
  btnTheme.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("juegos_naty_theme", isDark ? "dark" : "light");
    sounds.playQuestionTick();
  });

  window.addEventListener("game:add-point", ((e: CustomEvent) => {
    const points = Number(e.detail?.points) || 1;
    if (e.detail?.player === 1) state.p1Score += points;
    if (e.detail?.player === 2) state.p2Score += points;
    syncUI();
  }) as EventListener);

  window.addEventListener("game:reset-scores", () => {
    state.p1Score = 0;
    state.p2Score = 0;
    hasCrownedInThisMatch = false;
    syncUI();
  });

  window.addEventListener("game:switch-mode-free", () => {
    state.mode = "free";
    hasCrownedInThisMatch = false;
    syncUI();
  });

  syncUI();
</script>
