---
// src/components/SecretModal.astro
import { Dices } from "lucide-astro";
---

<dialog
  id="dialog-secret"
  class="p-5 sm:p-6 rounded-3xl backdrop:bg-slate-950/75 backdrop:backdrop-blur-xs max-w-sm sm:max-w-md w-full border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl m-auto text-center transition-colors"
>
  <div class="flex justify-between items-center mb-3">
    <span
      class="text-xs font-black uppercase text-indigo-600 dark:text-indigo-400 tracking-wider"
    >
      Tu Personaje Secreto
    </span>
    <button
      type="button"
      id="btn-close-dialog"
      class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg cursor-pointer"
    >
      ✕
    </button>
  </div>

  <div class="py-2 flex flex-col items-center">
    <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-3">
      Tapa la pantalla para que el otro no mire 👀
    </p>

    <!-- Tarjeta del Secreto Actual -->
    <div
      class="w-full bg-slate-50 dark:bg-slate-800/60 border-2 border-dashed border-indigo-200 dark:border-indigo-900/60 rounded-2xl p-3 sm:p-4 flex flex-col items-center gap-1.5 mb-3"
    >
      <div
        id="secret-img-container"
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden bg-white dark:bg-slate-900 shadow-sm flex items-center justify-center p-1.5 border border-slate-200 dark:border-slate-700"
      >
        <span
          id="secret-placeholder"
          class="text-3xl font-black text-slate-300 dark:text-slate-600 select-none"
        >
          ?
        </span>
        <img
          id="secret-img"
          src=""
          alt=""
          referrerpolicy="no-referrer"
          class="w-full h-full object-contain hidden"
        />
      </div>
      <h3
        id="secret-name"
        class="text-sm sm:text-base font-black text-slate-900 dark:text-white"
      >
        Sin asignar
      </h3>
      <p
        id="secret-studio-movie"
        class="text-[11px] font-medium text-slate-500 dark:text-slate-400"
      >
        Elige uno abajo o pulsa al azar
      </p>
    </div>

    <!-- EL SELECTOR DE NATY: Cuadrícula con los 12 personajes de la ronda -->
    <div class="w-full text-left mb-3">
      <p
        class="text-[11px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2"
      >
        Toca quién quieres ser tú:
      </p>
      <div
        id="secret-picker-grid"
        class="grid grid-cols-4 gap-1.5 sm:gap-2 max-h-44 overflow-y-auto p-1 rounded-2xl bg-slate-100/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800"
      >
        <!-- Inyectado dinámicamente con los 12 personajes de la ronda -->
      </div>
    </div>

    <!-- Botón Asignar al azar -->
    <button
      type="button"
      id="btn-randomize-secret"
      class="w-full py-2.5 px-3 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 rounded-xl text-xs font-bold border-2 border-slate-200 dark:border-slate-700 border-b-4 active:border-b-2 active:translate-y-[2px] transition cursor-pointer flex items-center justify-center gap-1.5"
    >
      <Dices class="w-3.5 h-3.5" />
      <span>Elegir uno al azar si no te decides</span>
    </button>
  </div>
</dialog>

<script>
  import { sounds } from "../utils/audio";
  import type { Character } from "../data/characters";

  const dialog = document.getElementById("dialog-secret") as HTMLDialogElement;
  const btnClose = document.getElementById("btn-close-dialog")!;
  const btnRandomize = document.getElementById("btn-randomize-secret")!;

  const secretPlaceholder = document.getElementById("secret-placeholder")!;
  const secretImg = document.getElementById("secret-img") as HTMLImageElement;
  const secretName = document.getElementById("secret-name")!;
  const secretStudioMovie = document.getElementById("secret-studio-movie")!;
  const pickerGrid = document.getElementById("secret-picker-grid")!;

  let currentRoundCharacters: Character[] = [];

  function setSecretCharacter(char: Character) {
    secretPlaceholder.classList.add("hidden");
    secretImg.classList.remove("hidden");
    secretImg.src = char.imageUrl;
    secretName.textContent = char.name;
    secretStudioMovie.textContent = `${char.studio} · ${char.movie}`;
    sounds.playVictory();

    // Resaltar en el picker
    pickerGrid
      .querySelectorAll<HTMLButtonElement>("button[data-picker-id]")
      .forEach((btn) => {
        if (btn.dataset.pickerId === char.id) {
          btn.classList.add(
            "border-indigo-600",
            "dark:border-indigo-400",
            "bg-indigo-100/70",
            "dark:bg-indigo-950",
          );
        } else {
          btn.classList.remove(
            "border-indigo-600",
            "dark:border-indigo-400",
            "bg-indigo-100/70",
            "dark:bg-indigo-950",
          );
        }
      });
  }

  function renderPicker(characters: Character[]) {
    pickerGrid.innerHTML = "";
    characters.forEach((char) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.dataset.pickerId = char.id;
      btn.className =
        "flex flex-col items-center p-1.5 rounded-xl bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 hover:border-indigo-500 transition cursor-pointer text-center";
      btn.innerHTML = `
        <div class="w-10 h-10 rounded-lg overflow-hidden bg-slate-50 dark:bg-slate-800 p-0.5 mb-1 pointer-events-none">
          <img src="${char.imageUrl}" alt="${char.name}" referrerpolicy="no-referrer" class="w-full h-full object-contain" />
        </div>
        <span class="text-[9px] font-bold text-slate-800 dark:text-slate-200 truncate w-full pointer-events-none">${char.name}</span>
      `;
      btn.addEventListener("click", () => setSecretCharacter(char));
      pickerGrid.appendChild(btn);
    });
  }

  window.addEventListener("game:characters-loaded", ((e: CustomEvent) => {
    currentRoundCharacters = e.detail?.characters || [];
    renderPicker(currentRoundCharacters);
    resetSecret();
  }) as EventListener);

  window.addEventListener("game:open-secret", () => {
    dialog.showModal();
  });

  btnClose.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  btnRandomize.addEventListener("click", () => {
    if (currentRoundCharacters.length === 0) return;
    const random =
      currentRoundCharacters[
        Math.floor(Math.random() * currentRoundCharacters.length)
      ];
    setSecretCharacter(random);
  });

  function resetSecret() {
    secretPlaceholder.classList.remove("hidden");
    secretImg.classList.add("hidden");
    secretImg.src = "";
    secretName.textContent = "Sin asignar";
    secretStudioMovie.textContent = "Toca uno abajo o elige al azar";
  }
</script>
