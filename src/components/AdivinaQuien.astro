---
// src/components/AdivinaQuien.astro
import ScoreBoard from "./ScoreBoard.astro";
import RoundControls from "./RoundControls.astro";
import SecretModal from "./SecretModal.astro";
import MeLaJuegoModal from "./MeLaJuegoModal.astro";
import ChampionModal from "./ChampionModal.astro";
import WinControls from "./WinControls.astro";
---

<div
  class="max-w-6xl mx-auto px-3 sm:px-4 py-4 sm:py-6 w-full flex flex-col gap-4 sm:gap-6 overflow-x-clip"
>
  <!-- Marcador Responsive con Campeón de Campeones -->
  <ScoreBoard />

  <!-- Controles Responsive con ¡Me la juego! y 2 Turnos -->
  <RoundControls />

  <!-- Diálogo accesible secreto con Selector de Naty y Alarma Espía -->
  <SecretModal />

  <!-- Diálogo ¡Me la juego! (Tiro a ciegas +3 pts) -->
  <MeLaJuegoModal />

  <!-- Diálogo Campeón de Campeones -->
  <ChampionModal />

  <!-- Banner Dinámico: ¡DEBES ADIVINAR AHORA ${NOMBRE_JUGADOR}! -->
  <div
    id="banner-guess-mode"
    class="hidden w-full p-3 sm:p-4 rounded-3xl bg-linear-to-r from-amber-500/20 via-rose-500/20 to-amber-500/20 border-2 border-amber-400 dark:border-amber-500 shadow-md flex flex-col sm:flex-row items-center justify-between gap-2.5 animate-pulse"
  >
    <div class="flex items-center gap-2.5">
      <span class="text-2xl select-none">🎯</span>
      <div class="text-left">
        <h3 class="text-xs sm:text-base font-black text-slate-900 dark:text-white uppercase tracking-tight">
          ¡DEBES ADIVINAR AHORA <span id="banner-guesser-name" class="text-amber-600 dark:text-amber-400">NATY</span>!
        </h3>
        <p id="banner-guess-subtitle" class="text-[10px] sm:text-xs font-semibold text-slate-600 dark:text-slate-300">
          Toca directamente la carta de tu personaje para ganar la ronda
        </p>
      </div>
    </div>
    <!-- Selector rápido de quién adivina -->
    <div class="flex items-center gap-1 bg-white/90 dark:bg-slate-900/90 p-1 rounded-xl border border-amber-300 dark:border-amber-700 shrink-0">
      <button
        type="button"
        id="btn-toggle-guesser-p1"
        class="px-2.5 py-1 rounded-lg text-xs font-black bg-indigo-600 text-white cursor-pointer shadow-xs transition"
      >
        <span id="banner-p1-text">Naty</span>
      </button>
      <button
        type="button"
        id="btn-toggle-guesser-p2"
        class="px-2.5 py-1 rounded-lg text-xs font-black bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer transition"
      >
        <span id="banner-p2-text">César</span>
      </button>
    </div>
  </div>

  <!-- Tablero dinámico de 12 cartas -->
  <main class="w-full">
    <div
      id="cards-grid"
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-5 min-h-[350px]"
    >
      <!-- Cartas inyectadas -->
    </div>
  </main>

  <!-- Fin de ronda -->
  <WinControls />

  <!-- Modal Celebración de Adivinanza Exitosa Directa -->
  <dialog
    id="dialog-guess-success"
    class="p-4 sm:p-6 rounded-3xl backdrop:bg-slate-950/80 backdrop:backdrop-blur-xs max-w-sm w-full border-2 border-emerald-500 bg-white dark:bg-slate-900 shadow-2xl m-auto text-center transition-colors overflow-hidden"
  >
    <div class="flex flex-col items-center gap-3">
      <div class="text-4xl animate-bounce">🎉</div>
      <div class="w-20 h-20 rounded-2xl overflow-hidden bg-slate-50 dark:bg-slate-800 p-1 border border-emerald-300 dark:border-emerald-700 shadow-sm">
        <img id="guess-success-img" src="" alt="" class="w-full h-full object-contain" />
      </div>
      <div>
        <span class="text-[10px] font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
          ¡Adivinanza Correcta! (+1 Punto)
        </span>
        <h3 id="guess-success-name" class="text-base sm:text-lg font-black text-slate-900 dark:text-white">
          Woody
        </h3>
        <p id="guess-success-desc" class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          ¡Naty adivinó el personaje secreto!
        </p>
      </div>
      <button
        type="button"
        id="btn-guess-success-next-round"
        class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-black uppercase tracking-wider border-b-4 border-indigo-800 active:border-b-0 active:translate-y-1 transition cursor-pointer shadow-sm"
      >
        Siguiente Turno / Ronda ➔
      </button>
    </div>
  </dialog>

  <!-- Modal Derrota: Falló la Adivinanza Directa -->
  <dialog
    id="dialog-guess-fail"
    class="p-4 sm:p-6 rounded-3xl backdrop:bg-slate-950/80 backdrop:backdrop-blur-xs max-w-sm w-full border-2 border-rose-500 bg-white dark:bg-slate-900 shadow-2xl m-auto text-center transition-colors overflow-hidden"
  >
    <div class="flex flex-col items-center gap-3">
      <div class="text-4xl animate-bounce">💥</div>

      <div>
        <span class="text-[10px] font-black uppercase tracking-wider text-rose-600 dark:text-rose-400">
          ¡Adivinanza Fallida! Ronda Perdida
        </span>
        <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white mt-0.5">
          No era <span id="guess-fail-picked-name" class="text-rose-600 dark:text-rose-400">...</span>
        </h3>
      </div>

      <!-- Revelar el secreto real -->
      <div class="w-full bg-slate-50 dark:bg-slate-800/60 p-3 rounded-2xl border border-slate-200 dark:border-slate-700 flex flex-col items-center gap-1.5">
        <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
          El personaje secreto era:
        </span>
        <div class="w-20 h-20 rounded-2xl overflow-hidden bg-white dark:bg-slate-900 p-1 border border-slate-200 dark:border-slate-700 shadow-xs">
          <img id="guess-fail-secret-img" src="" alt="" class="w-full h-full object-contain" />
        </div>
        <h4 id="guess-fail-secret-name" class="text-sm font-black text-slate-900 dark:text-white">
          ...
        </h4>
        <p id="guess-fail-secret-meta" class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">
          ...
        </p>
      </div>

      <p id="guess-fail-winner-desc" class="text-xs font-bold text-amber-600 dark:text-amber-400">
        ¡Punto para César! 🏆 (+1 punto)
      </p>

      <button
        type="button"
        id="btn-guess-fail-next-round"
        class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-black uppercase tracking-wider border-b-4 border-indigo-800 active:border-b-0 active:translate-y-1 transition cursor-pointer shadow-sm"
      >
        Siguiente Turno / Ronda ➔
      </button>
    </div>
  </dialog>
</div>

<script>
  import { sounds } from "../utils/audio";
  import { launchConfetti } from "../utils/confetti";
  import { CHARACTERS, type Character } from "../data/characters";

  const grid = document.getElementById("cards-grid")!;
  const bannerGuessMode = document.getElementById("banner-guess-mode")!;
  const bannerGuesserName = document.getElementById("banner-guesser-name")!;
  const bannerGuessSubtitle = document.getElementById("banner-guess-subtitle")!;
  const btnToggleP1 = document.getElementById("btn-toggle-guesser-p1")!;
  const btnToggleP2 = document.getElementById("btn-toggle-guesser-p2")!;
  const bannerP1Text = document.getElementById("banner-p1-text")!;
  const bannerP2Text = document.getElementById("banner-p2-text")!;

  let lastUsedIds = new Set<string>();
  let isGuessModeActive = false;
  let registeredSecret: Character | null = null;
  let pendingChar: Character | null = null;
  let pendingBtn: HTMLElement | null = null;

  // Jugadores para adivinanza
  let p1Name = "Naty";
  let p2Name = "César";
  let activeGuesser: 1 | 2 = 1;

  // Dialog Éxito en Adivinanza Directa
  const dialogSuccess = document.getElementById("dialog-guess-success") as HTMLDialogElement;
  const guessSuccessImg = document.getElementById("guess-success-img") as HTMLImageElement;
  const guessSuccessName = document.getElementById("guess-success-name")!;
  const guessSuccessDesc = document.getElementById("guess-success-desc")!;
  const btnSuccessNextRound = document.getElementById("btn-guess-success-next-round")!;

  // Dialog Derrota en Adivinanza Directa
  const dialogFail = document.getElementById("dialog-guess-fail") as HTMLDialogElement;
  const guessFailPickedName = document.getElementById("guess-fail-picked-name")!;
  const guessFailSecretImg = document.getElementById("guess-fail-secret-img") as HTMLImageElement;
  const guessFailSecretName = document.getElementById("guess-fail-secret-name")!;
  const guessFailSecretMeta = document.getElementById("guess-fail-secret-meta")!;
  const guessFailWinnerDesc = document.getElementById("guess-fail-winner-desc")!;
  const btnFailNextRound = document.getElementById("btn-guess-fail-next-round")!;

  function syncGuesserToggleUI() {
    const currentName = activeGuesser === 1 ? p1Name : p2Name;
    bannerGuesserName.textContent = currentName.toUpperCase();

    if (activeGuesser === 1) {
      btnToggleP1.className =
        "px-2.5 py-1 rounded-lg text-xs font-black bg-indigo-600 text-white cursor-pointer shadow-xs transition";
      btnToggleP2.className =
        "px-2.5 py-1 rounded-lg text-xs font-black bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer transition";
    } else {
      btnToggleP2.className =
        "px-2.5 py-1 rounded-lg text-xs font-black bg-amber-500 text-white cursor-pointer shadow-xs transition";
      btnToggleP1.className =
        "px-2.5 py-1 rounded-lg text-xs font-black bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer transition";
    }
  }

  btnToggleP1.addEventListener("click", () => {
    activeGuesser = 1;
    sounds.playQuestionTick();
    syncGuesserToggleUI();
    window.dispatchEvent(new CustomEvent("game:set-guesser", { detail: { guesser: 1 } }));
  });

  btnToggleP2.addEventListener("click", () => {
    activeGuesser = 2;
    sounds.playQuestionTick();
    syncGuesserToggleUI();
    window.dispatchEvent(new CustomEvent("game:set-guesser", { detail: { guesser: 2 } }));
  });

  // Barajado inteligente
  function getRandom12Characters(): Character[] {
    const fresh = CHARACTERS.filter((c) => !lastUsedIds.has(c.id));
    const previous = CHARACTERS.filter((c) => lastUsedIds.has(c.id));

    const shuffle = (arr: Character[]) => {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    };

    const shuffledFresh = shuffle(fresh);
    const shuffledPrevious = shuffle(previous);

    const combined = [...shuffledFresh, ...shuffledPrevious];
    const selected = combined.slice(0, 12);

    lastUsedIds = new Set(selected.map((c) => c.id));
    return shuffle(selected);
  }

  function renderCard(char: Character): HTMLElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.dataset.id = char.id;
    btn.dataset.discarded = "false";
    btn.className =
      "group relative flex flex-col items-center justify-between p-2.5 sm:p-4 rounded-3xl bg-white dark:bg-slate-900 border-2 border-slate-200/90 dark:border-slate-800 hover:border-indigo-400 dark:hover:border-indigo-500 shadow-sm hover:shadow-md transition-all duration-300 ease-out cursor-pointer select-none text-left w-full h-[195px] sm:h-[260px] overflow-hidden data-[discarded=true]:[transform:perspective(800px)_rotateX(26deg)_scale(0.92)] data-[discarded=true]:grayscale data-[discarded=true]:opacity-35 data-[discarded=true]:border-slate-300 dark:data-[discarded=true]:border-slate-800 active:scale-95";

    btn.innerHTML = `
      <!-- Cabecera de la carta -->
      <div class="w-full flex items-center justify-between gap-1 text-[9px] sm:text-[10px] font-bold">
        <span class="px-1.5 sm:px-2 py-0.5 rounded-full ${char.studio === "Pixar" ? "bg-purple-100 dark:bg-purple-950/70 text-purple-700 dark:text-purple-300" : "bg-sky-100 dark:bg-sky-950/70 text-sky-700 dark:text-sky-300"}">
          ${char.studio}
        </span>
        <span class="text-slate-400 dark:text-slate-500 truncate max-w-[80px] sm:max-w-[110px] font-medium">${char.movie}</span>
      </div>

      <!-- Foto Real -->
      <div class="relative w-full flex-1 my-1 sm:my-2 flex items-center justify-center overflow-hidden rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 p-1">
        <img
          src="${char.imageUrl}"
          alt="${char.name}"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class="w-full h-full object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-300"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="hidden w-full h-full items-center justify-center text-slate-300 dark:text-slate-600">
          <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        </div>
      </div>

      <!-- Nombre -->
      <div class="w-full text-center">
        <h3 class="text-xs sm:text-sm font-black text-slate-900 dark:text-white truncate">
          ${char.name}
        </h3>
      </div>

      <!-- Sello de Descartado -->
      <div class="absolute inset-0 bg-slate-950/20 backdrop-blur-[1px] hidden items-center justify-center pointer-events-none group-data-[discarded=true]:flex">
        <span class="bg-rose-600 text-white font-black text-[10px] sm:text-xs px-2.5 sm:px-3.5 py-0.5 sm:py-1 rounded-full shadow-lg -rotate-12 border-2 border-white tracking-wider">
          DESCARTADO ✕
        </span>
      </div>
    `;

    btn.addEventListener("click", () => {
      // Todo depende del secreto: si no han elegido, abre el modal
      if (!registeredSecret) {
        sounds.playSecretAlert();
        window.dispatchEvent(new CustomEvent("game:open-secret"));
        return;
      }

      if (isGuessModeActive) {
        // MODO ADIVINANZA DIRECTA (3º acto tras los 2 turnos marcados)
        const guesserName = activeGuesser === 1 ? p1Name : p2Name;
        const keeperPlayer = activeGuesser === 1 ? 2 : 1;
        const keeperName = keeperPlayer === 1 ? p1Name : p2Name;

        if (registeredSecret.id === char.id) {
          // ¡LE ATINÓ AL PERSONAJE SECRETO!
          sounds.playVictory();
          launchConfetti();
          setTimeout(() => launchConfetti(), 400);

          window.dispatchEvent(
            new CustomEvent("game:add-point", {
              detail: { player: activeGuesser, points: 1 },
            }),
          );

          guessSuccessImg.src = char.imageUrl;
          guessSuccessName.textContent = char.name;
          guessSuccessDesc.textContent = `¡${guesserName} adivinó el personaje secreto! Ganó 1 punto 🏆`;
          dialogSuccess.showModal();
        } else {
          // FALLÓ LA ADIVINANZA: PIERDE LA RONDA Y PUNTO PARA EL RIVAL
          sounds.playFail();

          window.dispatchEvent(
            new CustomEvent("game:add-point", {
              detail: { player: keeperPlayer, points: 1 },
            }),
          );

          guessFailPickedName.textContent = char.name;
          guessFailSecretImg.src = registeredSecret.imageUrl;
          guessFailSecretName.textContent = registeredSecret.name;
          guessFailSecretMeta.textContent = `${registeredSecret.studio} · ${registeredSecret.movie}`;
          guessFailWinnerDesc.textContent = `¡${guesserName} falló! Punto para ${keeperName} 🏆 (+1 punto)`;
          dialogFail.showModal();
        }
      } else {
        // MODO NORMAL: Volteo / descarte manual de carta
        sounds.playFlip();
        const isDiscarded = btn.dataset.discarded === "true";
        btn.dataset.discarded = isDiscarded ? "false" : "true";
      }
    });

    return btn;
  }

  btnSuccessNextRound.addEventListener("click", () => {
    dialogSuccess.close();
    window.dispatchEvent(new CustomEvent("game:request-new-round"));
  });

  dialogSuccess.addEventListener("click", (e) => {
    if (e.target === dialogSuccess) dialogSuccess.close();
  });

  btnFailNextRound.addEventListener("click", () => {
    dialogFail.close();
    window.dispatchEvent(new CustomEvent("game:request-new-round"));
  });

  dialogFail.addEventListener("click", (e) => {
    if (e.target === dialogFail) dialogFail.close();
  });

  function loadNewRound() {
    const characters = getRandom12Characters();

    grid.innerHTML = "";
    characters.forEach((c) => grid.appendChild(renderCard(c)));

    sounds.playFlip();
    window.dispatchEvent(
      new CustomEvent("game:characters-loaded", { detail: { characters } }),
    );
  }

  window.addEventListener("game:request-new-round", loadNewRound);
  window.addEventListener("game:request-reset-flips", () => {
    grid
      .querySelectorAll<HTMLButtonElement>("button[data-id]")
      .forEach((btn) => {
        btn.dataset.discarded = "false";
      });
  });

  window.addEventListener("game:guess-mode-active", ((e: CustomEvent) => {
    isGuessModeActive = Boolean(e.detail?.active);
    if (e.detail?.guesser) {
      activeGuesser = e.detail.guesser;
      syncGuesserToggleUI();
    }
    if (isGuessModeActive) {
      bannerGuessSubtitle.textContent =
        "🎯 Toca la carta de tu sospechoso. ¡Si aciertas ganas +1 pt, pero si fallas el punto es para tu rival!";
      bannerGuessMode.classList.remove("hidden");
      bannerGuessMode.classList.add("flex");
      sounds.playQuestionTick();
    } else {
      bannerGuessMode.classList.add("hidden");
      bannerGuessMode.classList.remove("flex");
    }
  }) as EventListener);

  window.addEventListener("game:secret-changed", ((e: CustomEvent) => {
    registeredSecret = e.detail?.character || null;
  }) as EventListener);

  window.addEventListener("game:roles-changed", ((e: CustomEvent) => {
    if (e.detail?.guesser) {
      activeGuesser = e.detail.guesser;
      syncGuesserToggleUI();
    }
  }) as EventListener);

  window.addEventListener("game:players-updated", ((e: CustomEvent) => {
    if (e.detail?.p1Name) {
      p1Name = e.detail.p1Name;
      bannerP1Text.textContent = p1Name;
    }
    if (e.detail?.p2Name) {
      p2Name = e.detail.p2Name;
      bannerP2Text.textContent = p2Name;
    }
    syncGuesserToggleUI();
  }) as EventListener);

  setTimeout(() => {
    loadNewRound();
    syncGuesserToggleUI();
    window.dispatchEvent(new CustomEvent("game:request-sync-roles"));
  }, 60);
</script>
